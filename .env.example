# No environment variables or API keys are required.
# This game runs 100% in the browser using localStorage / IndexedDB.

# Private stats dashboard (/stats) — PUBLIC Firebase web config for the
# dedicated project "point-catcher-stats" (not secret; it ships in the bundle).
# Set these four in Vercel → Project → Settings → Environment Variables.
# If any is missing, analytics are disabled and the game runs normally.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="point-catcher-stats.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="point-catcher-stats"
VITE_FIREBASE_APP_ID="1:1003006438165:web:7d1673ce6c91b73f09171c"
